<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Define the directory where logs will be stored -->
    <property name="LOG_PATH" value="./logs" />
    <property name="LOG_FILE_NAME" value="eauction-backend" />

    <!-- 1. Console Appender (Human-readable with Trace ID for local development) -->
    <appender name="ConsoleAppender" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{36}) [TraceId: %X{traceId:-}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 2. Rolling File Appender (Structured JSON Format for ELK / Filebeat ingestion) -->
    <appender name="RollingFileAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE_NAME}.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${LOG_FILE_NAME}-%d{yyyy-MM-dd}.%i.log</fileNamePattern>

            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>10MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>

            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>

        <!-- Structured JSON Encoder using logstash-logback-encoder -->
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <version>version</version>
                <level>level</level>
                <thread>thread</thread>
                <logger>logger</logger>
                <message>message</message>
                <stackTrace>stack_trace</stackTrace>
            </fieldNames>
        </encoder>
    </appender>

    <!-- 3. Dedicated Appender for Webhooks & Payments (Audit Log) -->
    <appender name="PaymentAuditAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/payment-audit.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/payment-audit-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>90</maxHistory>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [TraceId: %X{traceId:-}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Logger for Payment & Webhook Services -->
    <logger name="com.eAuction.backend.service.PaymentServiceImpl" level="INFO" additivity="true">
        <appender-ref ref="PaymentAuditAppender" />
    </logger>

    <!-- Logger for SQL Hibernate Queries -->
    <logger name="org.hibernate.SQL" level="WARN" />

    <!-- Single Unified Root Logger -->
    <root level="INFO">
        <appender-ref ref="ConsoleAppender" />
        <appender-ref ref="RollingFileAppender" />
    </root>

</configuration>